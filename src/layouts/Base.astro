---
import '../styles/global.css';
import Mark from '../components/Mark.astro';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title = 'Vance Wallace — AI-native product leader',
  description = 'Senior product manager working across AI, spatial computing and games. Side projects and playable demos.',
  home = false,
} = Astro.props;

const base = home ? '' : '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Add a 1200×630 share image at public/og.png and uncomment: -->
    <!-- <meta property="og:image" content="/og.png" /> -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a href="/" class="brand"><Mark /> VANCE WALLACE</a>
        <nav class="site-nav" aria-label="Primary">
          <a class="tap" href={`${base}#projects`}>Projects</a>
          <a class="tap" href={`${base}#about`}>About</a>
          <a class="tap" href={`${base}#work-with-me`}>Work with me</a>
          <a class="tap" href={`${base}#contact`}>Contact</a>
          <a class="tap accent" href="[RESUME PDF LINK]">Résumé ↗</a>
        </nav>
      </header>
    </div>

    <main>
      <slot />
    </main>

    <div class="wrap">
      <footer id="contact" class="site-footer">
        <h2>Building something where AI meets real behavior? Let's talk.</h2>
        <div class="contact-links">
          <a class="tap email" href="mailto:vwallace@alumni.cmu.edu">vwallace@alumni.cmu.edu</a>
          <a class="tap" href="[LINKEDIN URL]">LinkedIn ↗</a>
          <a class="tap" href="https://github.com/VanceWallace">GitHub ↗</a>
          <a class="tap" href="[YOUTUBE URL]">YouTube ↗</a>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} VANCE WALLACE</span>
          <span>[YOURDOMAIN.COM]</span>
        </div>
      </footer>
    </div>
  </body>
</html>
