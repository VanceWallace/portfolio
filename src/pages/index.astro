---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkWithMe from '../components/WorkWithMe.astro';
import About from '../components/About.astro';
import { projects } from '../data/projects';
---
<Base home>
  <section id="top" class="hero grid-bg">
    <div class="wrap hero-inner">
      <div class="eyebrow">Senior product manager · AI · Spatial · Games</div>
      <h1>AI-native product leader. I direct AI-assisted builds toward outcomes people actually feel.</h1>
      <p class="lede">
        Twenty years shipping consumer products across Meta Reality Labs, Schell Games, EA and Tagged.
        Below is what I'm building now: small, playable things made with AI.
      </p>
      <div class="actions">
        <a class="btn btn-solid" href="#projects">Try the demos</a>
        <a class="btn btn-line" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="projects" class="wrap section">
    <div class="section-head">
      <h2>Side projects &amp; demos</h2>
      <span class="label">Playable in the browser</span>
    </div>
    <div class="cards">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <WorkWithMe />
  <About />
</Base>
